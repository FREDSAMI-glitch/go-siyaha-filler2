  "expert_generation_defaults": {
    "dirigeant.profil": "Titulaire d’une formation supérieure et doté d’une expérience en gestion de projet, le dirigeant dispose des compétences nécessaires pour piloter le développement commercial, opérationnel et financier du projet.",
    "projet.description_offre_animation": "Le projet vise à proposer une offre d’animation touristique structurée, combinant expérience client, sécurité, qualité de service et valorisation de l’attractivité locale.",
    "synthese_etude_marche": "Le marché ciblé présente un potentiel lié à la dynamique touristique régionale, à l’évolution de la demande pour les expériences de loisirs et à la recherche d’offres différenciées. Le projet répond à un besoin d’animation complémentaire permettant d’améliorer l’expérience des visiteurs, d’augmenter la durée de séjour et de renforcer l’attractivité de la destination.",
    "strategie_approvisionnement.description": "L’approvisionnement reposera sur une sélection de fournisseurs locaux et régionaux afin de garantir la disponibilité des intrants, la réactivité logistique et la maîtrise des coûts. L’entreprise privilégiera des partenaires offrant des conditions de qualité, de délai et de service compatibles avec les exigences d’exploitation.",
    "strategie_commerciale.description": "La stratégie commerciale combinera une approche B2C à travers la clientèle touristique et locale, et une approche B2B via des partenariats avec hôtels, agences, transporteurs et opérateurs touristiques. La politique commerciale visera la visibilité digitale, les partenariats prescripteurs et la fidélisation.",
    "facteurs_differenciation": "Le projet se différencie par la structuration de son offre, la qualité de l’expérience client, la localisation, la capacité à nouer des partenariats touristiques et l’intégration de standards de sécurité et de service adaptés à la clientèle nationale et internationale.",
    "emplois.argumentaire_indirects": "Les emplois indirects seront générés principalement auprès des fournisseurs, sous-traitants, prestataires de transport, maintenance, communication, animation, petits travaux et services connexes liés à l’exploitation du projet.",
    "attractivite_touristique": "Le projet contribuera à renforcer l’attractivité touristique de la destination en diversifiant les activités proposées aux visiteurs, en améliorant l’expérience de séjour et en créant une offre complémentaire aux circuits touristiques existants."
  },
